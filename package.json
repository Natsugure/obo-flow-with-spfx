{
  "name": "obo-flow-with-spfx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Microsoft Graph Change Notifications with SPFx and OBO Flow",
 "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter spfx-frontend start",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter spfx-frontend build",
    "build:shared": "pnpm --filter shared build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
